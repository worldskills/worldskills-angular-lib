{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "worldskills-ng-auth": {
      "projectType": "library",
      "root": "projects/worldskills-ng-auth",
      "sourceRoot": "projects/worldskills-ng-auth/src",
      "prefix": "ws-ng-auth",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/worldskills-ng-auth/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/worldskills-ng-auth/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/worldskills-ng-auth/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "worldskills-ng-ui": {
      "projectType": "library",
      "root": "projects/worldskills-ng-ui",
      "sourceRoot": "projects/worldskills-ng-ui/src",
      "prefix": "ws-ng-ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/worldskills-ng-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/worldskills-ng-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/worldskills-ng-ui/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "worldskills-ng-tester-prime": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/worldskills-ng-tester-prime",
      "sourceRoot": "projects/worldskills-ng-tester-prime/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/worldskills-ng-tester-prime/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/worldskills-ng-tester-prime/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/worldskills-ng-tester-prime/public"
              }
            ],
            "styles": [
              "projects/worldskills-ng-tester-prime/src/styles.scss",
              "node_modules/primeicons/primeicons.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "worldskills-ng-tester-prime:build:production"
            },
            "development": {
              "buildTarget": "worldskills-ng-tester-prime:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "build-webpack": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "index": "projects/worldskills-ng-tester-prime/src/index.html",
            "main": "projects/worldskills-ng-tester-prime/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/worldskills-ng-tester-prime/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/worldskills-ng-tester-prime/public"
              }
            ],
            "styles": [],
            "outputPath": "dist/worldskills-ng-tester-prime-webpack"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "worldskills-ng-tester-prime:build-webpack:development",
            "tsConfig": ".storybook/tsconfig.json",
            "port": 6006,
            "compodoc": false,
            "styles": [
              ".storybook/storybook.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "worldskills-ng-tester-prime:build-webpack:development",
            "tsConfig": ".storybook/tsconfig.json",
            "outputDir": "dist/storybook",
            "compodoc": false,
            "styles": [
              ".storybook/storybook.css"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/worldskills-ng-tester-prime/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/worldskills-ng-tester-prime/public"
              }
            ],
            "styles": [
              "projects/worldskills-ng-tester-prime/src/styles.scss"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
